{
  "name": "UrbanCart",
  "dataColors": [
    "#2A78D6",
    "#EB6834",
    "#1BAF7A",
    "#EDA100",
    "#E87BA4",
    "#008300",
    "#4A3AA7",
    "#E34948"
  ],
  "foreground": "#1B2432",
  "foregroundNeutralSecondary": "#52514E",
  "foregroundNeutralTertiary": "#898781",
  "background": "#FFFFFF",
  "backgroundLight": "#F7F7F5",
  "backgroundNeutral": "#E4E4E0",
  "tableAccent": "#2A78D6",
  "good": "#0CA30C",
  "neutral": "#FAB219",
  "bad": "#D03B3B",
  "maximum": "#104281",
  "center": "#F0EFEC",
  "minimum": "#CDE2FB",
  "textClasses": {
    "callout": {
      "fontSize": 22,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B2432"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B2432"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B2432"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#52514E"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E4E4E0"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "subTitle": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1B2432"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 8,
            "left": 12,
            "right": 12
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#898781"
              }
            },
            "fontSize": 9,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#ECECE8"
              }
            },
            "gridlineStyle": "solid",
            "labelColor": {
              "solid": {
                "color": "#898781"
              }
            },
            "fontSize": 9,
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "labelColor": {
              "solid": {
                "color": "#52514E"
              }
            },
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#52514E"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F3F0"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F3F3F0"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1B2432"
              }
            },
            "fontSize": 20,
            "fontFamily": "Segoe UI Semibold",
            "labelDisplayUnits": 1
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#898781"
              }
            },
            "fontSize": 9
          }
        ],
        "padding": [
          {
            "top": 4,
            "bottom": 4,
            "left": 8,
            "right": 8
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1F3350"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false,
            "radius": 6
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#AFC0D6"
              }
            },
            "textSize": 8
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "background": {
              "solid": {
                "color": "#1F3350"
              }
            },
            "textSize": 9
          }
        ],
        "padding": [
          {
            "top": 2,
            "bottom": 2,
            "left": 8,
            "right": 8
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EFEFEC"
              }
            },
            "rowPadding": 4,
            "outlineColor": {
              "solid": {
                "color": "#E4E4E0"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#52514E"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F7F7F5"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#1B2432"
              }
            },
            "fontSize": 9,
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "total": [
          {
            "totals": false
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2,
            "showMarker": false
          }
        ]
      }
    },
    "areaChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Right"
          }
        ],
        "labels": [
          {
            "show": true,
            "labelStyle": "Percent of total"
          }
        ]
      }
    }
  }
}