	partition Forecasts = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "forecasts.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"stock_code", type text}, {"run", type text}, {"method", type text}, {"week_no", Int64.Type}, {"horizon", Int64.Type}, {"forecast_units", type number}, {"is_chosen", type logical}}, "en-GB")
				in
				    Typed

	annotation PBI_ResultType = Table
