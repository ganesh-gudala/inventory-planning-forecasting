	partition WeeklyDemand = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "weekly_demand.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"stock_code", type text}, {"week_no", Int64.Type}, {"week_start", type date}, {"period", type text}, {"units_sold", Int64.Type}, {"units_returned", Int64.Type}, {"demand_units", Int64.Type}, {"sales_value", type number}, {"net_value", type number}}, "en-GB")
				in
				    Typed

	annotation PBI_ResultType = Table
