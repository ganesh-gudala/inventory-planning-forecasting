	partition Products = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "sku_list.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"stock_code", type text}, {"description", type text}, {"value_rank", Int64.Type}, {"net_value_52w", type number}, {"units_52w", Int64.Type}, {"avg_price", type number}, {"avg_weekly_52w", type number}, {"sd_weekly_52w", type number}, {"cv", type number}, {"cum_value_share", type number}, {"abc", type text}, {"xyz", type text}, {"abc_xyz", type text}, {"weeks_with_sales", Int64.Type}, {"peak_uplift", type number}, {"is_seasonal", type logical}}, "en-GB")
				in
				    Typed

	annotation PBI_ResultType = Table
